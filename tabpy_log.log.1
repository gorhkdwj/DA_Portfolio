2026-03-19,10:49:29 [INFO] (base_handler.py:base_handler:115): function to evaluate=def _user_script(tabpy, _arg1, _arg2, _arg3, _arg4):
 
 import numpy as np
 from sklearn.cluster import KMeans, MiniBatchKMeans
 
 x1 = np.asarray(_arg1, dtype=np.float32)
 x2 = np.asarray(_arg2, dtype=np.float32)
 algo = _arg3[0]; k = int(_arg4[0])
 
